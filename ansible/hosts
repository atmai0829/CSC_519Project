[myserver]
{{ SSH_HOST }} ansible_user={{ SSH_USER }} ansible_ssh_private_key_file=/tmp/ssh_key ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'

[myserver:vars]
ansible_python_interpreter=/usr/bin/python3
docker_container_name=coffee-project-container
docker_image=coffee-project:latest